# Copie para ~/.config/heygen/.env e preencha. Depois: chmod 600 ~/.config/heygen/.env
#
# Este arquivo é só o modelo — NUNCA preencha os valores aqui dentro do repo.
# Um segredo commitado uma vez fica no histórico do git para sempre, mesmo apagado depois.

# Obrigatório. HeyGen → Settings → API. Gasta o pool de API (Pay-As-You-Go).
HEYGEN_API_KEY=

# Opcionais: avatar e voz usados quando você não passa --look/--avatar/--voice.
# Descubra com: node skills/heygen-cli/scripts/heygen.mjs avatars
#               node skills/heygen-cli/scripts/heygen.mjs voices --lang pt
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Opcionais: entrega no Telegram. Sem os dois, o vídeo só é salvo local.
# Token: @BotFather. Chat: o id do chat/grupo que recebe o vídeo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
